#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&led_strip { chain-length = <27>; };

/ {
    combos {
        compatible = "zmk,combos";

        Layer_3 {
            bindings = <&mo 3>;
            key-positions = <37 40>;
        };

        pwr_off_L {
            bindings = <&soft_off>;
            key-positions = <0 5 38>;
        };

        pwr_off_R {
            bindings = <&soft_off>;
            key-positions = <39 6 11>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | SHFT |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | CTRL |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | ALT | LWR | SPC |   | ENT | RSE  | GUI |

            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y    &kp U  &kp I          &kp O       &kp P          &kp BACKSPACE
&kp LSHFT  &kp A  &kp S  &kp D     &kp F  &kp G        &kp H    &kp J  &kp K          &kp L       &kp SEMICOLON  &kp DELETE
&kp LCTRL  &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N    &kp M  &kp COMMA      &kp PERIOD  &kp SLASH      &kp ESCAPE
                         &kp LALT  &mo 1  &kp SPACE    &kp RET  &mo 2  &kp RIGHT_ALT
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | SHFT | BT1 | BT2 | BT3 | BT4 | BT5 |   |     |  UP |     |     |     |      |
            // | BTCLR|     |     |     |     |     |   | LFT | DWN | RGT |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB    &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5    &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8   &kp NUMBER_9  &kp NUMBER_0  &kp BSPC
&kp LSHFT  &trans        &trans        &trans        &trans        &trans          &trans        &trans        &kp UP_ARROW   &trans        &trans        &trans
&trans     &trans        &trans        &trans        &trans        &trans          &trans        &kp LEFT      &kp DOWN       &kp RIGHT     &trans        &trans
                                       &kp LGUI      &trans        &kp SPACE       &kp RET       &trans        &kp RIGHT_ALT
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | SHFT |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | CTRL |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB    &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_NUMBER_4  &kp KP_NUMBER_5    &kp KP_NUMBER_6  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_NUMBER_0  &kp BSPC
&kp LSHFT  &trans           &trans           &trans           &trans           &trans             &kp MINUS        &kp EQUAL        &kp LBKT         &kp RBKT         &kp BSLH         &kp GRAVE
&kp LCTRL  &trans           &trans           &trans           &trans           &trans             &kp UNDER        &kp PLUS         &kp LBRC         &kp RBRC         &kp PIPE         &kp TILDE
                                             &kp LGUI         &trans           &kp SPACE          &kp RET          &trans           &kp RALT
            >;
        };

        layer_3 {
            bindings = <
&kp TAB     &kp F1        &kp F2        &kp F3            &kp F4        &kp F5          &kp F6   &kp F7    &kp F8        &kp F9     &kp F10  &kp BSPC
&kp LSHFT   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2      &bt BT_SEL 3  &bt BT_SEL 4    &kp F11  &kp F12   &kp F13       &kp F14    &kp F15  &trans
&bt BT_CLR  &soft_off     &trans        &trans            &trans        &trans          &trans   &kp LEFT  &kp DOWN      &kp RIGHT  &trans   &trans
                                        &kp LA(LEFT_ALT)  &trans        &kp SPACE       &kp RET  &trans    &kp LEFT_GUI
            >;
        };
    };
};
