#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&led_strip { chain-length = <27>; };

&soft_off {
    hold-time-ms = <100>;

    /delete-property/ split-peripheral-off-on-press;
};

/ {
    combos {
        compatible = "zmk,combos";

        Layer_3 {
            bindings = <&mo 3>;
            key-positions = <37 40>;
        };

        pwr_off_L {
            bindings = <&soft_off>;
            key-positions = <0 5 38>;
        };

        pwr_off_R {
            bindings = <&soft_off>;
            key-positions = <39 6 11>;
        };
    };

    macros {
        new_macro: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&soft_off &kp TAB &kp SPACE &kp R>;
            label = "NEW_MACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | SHFT |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | CTRL |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | ALT | LWR | SPC |   | ENT | RSE  | GUI |

            bindings = <
&kp TAB    &kp A  &kp Z  &kp E     &kp R  &kp T        &kp Y    &kp U      &kp I          &kp O       &kp P      &kp BACKSPACE
&kp LSHFT  &kp Q  &kp S  &kp D     &kp F  &kp G        &kp H    &kp J      &kp K          &kp L       &kp M      &kp SINGLE_QUOTE
&kp LCTRL  &kp W  &kp X  &kp C     &kp V  &kp B        &kp N    &kp COMMA  &kp SEMICOLON  &kp PERIOD  &kp SLASH  &kp ESCAPE
                         &kp LALT  &mo 1  &kp SPACE    &kp RET  &mo 2      &kp RIGHT_ALT
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | SHFT | BT1 | BT2 | BT3 | BT4 | BT5 |   |     |  UP |     |     |     |      |
            // | BTCLR|     |     |     |     |     |   | LFT | DWN | RGT |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB     &kp N1        &kp N2        &kp N3        &kp N4        &kp N5          &kp N6   &kp N7    &kp N8        &kp N9     &kp N0  &kp BSPC
&kp LSHFT   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans   &trans    &kp UP_ARROW  &trans     &trans  &trans
&bt BT_CLR  &trans        &trans        &trans        &trans        &trans          &trans   &kp LEFT  &kp DOWN      &kp RIGHT  &trans  &trans
                                        &kp LGUI      &trans        &kp SPACE       &kp RET  &trans    &kp LEFT_GUI
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | SHFT |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | CTRL |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB    &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS   &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &kp BSPC
&kp LSHFT  &trans    &trans  &trans    &trans    &trans       &kp MINUS  &kp EQUAL  &kp LBKT         &kp RBKT  &kp BSLH  &kp GRAVE
&kp LCTRL  &trans    &trans  &trans    &trans    &trans       &kp UNDER  &kp PLUS   &kp LBRC         &kp RBRC  &kp PIPE  &kp TILDE
                             &kp LGUI  &trans    &kp SPACE    &kp RET    &trans     &kp RALT
            >;
        };

        layer_3 {
            bindings = <
&kp TAB     &kp N1        &kp N2        &kp N3        &kp N4        &kp N5          &kp N6   &kp N7    &kp N8        &kp N9     &kp N0  &kp BSPC
&kp LSHFT   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans   &trans    &kp UP_ARROW  &trans     &trans  &trans
&bt BT_CLR  &kp T         &trans        &trans        &trans        &trans          &trans   &kp LEFT  &kp DOWN      &kp RIGHT  &trans  &trans
                                        &kp LGUI      &trans        &kp SPACE       &kp RET  &trans    &kp LEFT_GUI
            >;
        };
    };
};
